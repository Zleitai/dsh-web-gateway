{
  # Disable the admin API; do not enable request/access logging.
  admin off
  http_port 8080
}
{$SITE_ADDRESS::8080} {
  header {
    Referrer-Policy "no-referrer"
    X-Content-Type-Options "nosniff"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
    -Server
  }
  @api path /v1/* /health
  handle @api {
    reverse_proxy relay:4090
  }
  # Metrics stay on the internal relay network.
  handle /metrics {
    respond 404
  }
  handle {
    root * /srv
    @entry path / /index.html /sw.js /manifest.webmanifest
    header @entry Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
