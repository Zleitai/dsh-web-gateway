# Local self-host smoke test. A phone on another network needs public HTTPS.
SITE_ADDRESS=:8080
MOBILE_ORIGIN=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=443
# Blank = self-host registration is open. Default hosted beta MUST set an invite.
RELAY_INVITE=
RELAY_INVITE_USES=20
RELAY_MAX_HOSTS=100
RELAY_MAX_CONNECTIONS=500
RELAY_MAX_PEERS=8
RELAY_MESSAGES_PER_MINUTE=6000
RELAY_MAX_BUFFERED_BYTES=1048576
